@page "/posts/drafts"
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using ModernBlog.Domain.Posts
@using ModernBlog.Infrastructure.Persistence
@using ModernBlog.Web.Components.Dtos
@inject BlogDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<h3>Your Drafts</h3>

@if (loading)
{
    <p>Loading…</p>
}
else if (!isAuthenticated)
{
    <p>Please <a href="/Identity/Account/Login">sign in</a> to view your drafts.</p>
}
else if (drafts == null || !drafts.Any())
{
    <p>No drafts found. <a href="/posts/new">Create a new post</a>.</p>
}
else
{
    <ul class="list-group">
        @foreach (var p in drafts)
        {
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <div>
                    <a href="@($"/posts/{p.Slug}/edit")"><strong>@p.Title</strong></a>
                    <div class="text-muted small">Created: @p.PublishAtUtc</div>
                </div>
                <div>
                    <a class="btn btn-sm btn-outline-primary" href="@($"/posts/{p.Slug}/edit")">Edit</a>
                    <a class="btn btn-sm btn-outline-secondary ms-2" href="@($"/posts/{p.Slug}")">Preview</a>
                </div>
            </li>
        }
    </ul>
}

@code {
    private List<PostDto>? drafts = new();
    private bool isAuthenticated;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        isAuthenticated = user?.Identity?.IsAuthenticated == true;

        if (!isAuthenticated)
        {
            loading = false;
            return;
        }

        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId))
        {
            loading = false;
            return;
        }

        // Only load drafts (PublishedAtUtc == null). Order by CreatedAtUtc to avoid DateTimeOffset ORDER BY issue.
        var dbDrafts = await Db.Posts
            .Where(p => p.AuthorId == userId && p.PublishedAtUtc == null)
            .OrderByDescending(p => p.Id)
            .ToListAsync();

        foreach (var dbPost in dbDrafts)
        {
            drafts.Add(new PostDto
            {
                Title = dbPost.Title,
                Slug = dbPost.Slug,
                Markdown = dbPost.Markdown,
                Excerpt = dbPost.Excerpt,
                SeoTitle = dbPost.SeoTitle,
                SeoDescription = dbPost.SeoDescription,
                PublishAtUtc = dbPost.PublishedAtUtc?.ToString("d MMMM yyyy") ?? dbPost.CreatedAtUtc.ToString("d MMMM yyyy")
            });
        }

        loading = false;
    }
}
