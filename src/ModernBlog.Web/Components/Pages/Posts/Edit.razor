@page "/posts/{Slug}/edit"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ModernBlog.Core.Markdown
@using ModernBlog.Core.Persistence
@using ModernBlog.Web.Components.Dtos
@inject BlogDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer
@using Markdig
@inject IMarkdownRenderer MarkdownRenderer

@code {
    [Parameter]
    public string Slug { get; set; } = default!;
}

<h3>Edit Post</h3>

@if (loading)
{
    <p>Loading…</p>
}
else if (notFound)
{
    <p>Post not found.</p>
}
else if (notAuthorized)
{
    <p>You are not authorized to edit this post.</p>
}
else if (editModel is null)
{
    <p>Error loading post.</p>
}
else
{


    <div class="post-editor-page">

        <span class="ms-2">@testMessage</span>

        <EditForm Model="@editModel"
                  OnValidSubmit="@SaveAsync"
                  FormName="EditPost">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label" for="title">Title</label>
                <InputText id="title"
                           class="form-control"
                           @bind-Value="editModel.Title" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="slug">Slug</label>
                <InputText id="slug"
                           class="form-control"
                           @bind-Value="editModel.Slug" />
            </div>

            <div class="markdown-workspace">
                <div class="markdown-pane">
                    <label class="form-label" for="markdown">
                        Markdown
                    </label>

                    <InputTextArea id="markdown"
                                   class="form-control markdown-editor"
                                   @bind-Value="editModel.Markdown"
                                   @oninput="OnMarkdownInput"
                                   rows="24" />
                </div>

                <div class="markdown-pane">
                    <label class="form-label">
                        Preview
                    </label>

                    <div class="markdown-preview">
                        @((MarkupString)MarkdownRenderer.Render(editModel.Markdown))
                    </div>
                </div>
            </div>

            <div class="form-check mb-3">
                <InputCheckbox id="publish"
                               class="form-check-input"
                               @bind-Value="isPublish" />

                <label class="form-check-label" for="publish">
                    Publish
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary">
                    Save
                </button>

                <button type="button" class="btn btn-secondary" @onclick="Cancel">
                    Cancel
                </button>
            </div>
        </EditForm>
    </div>
    
}

@code {
    private PostDto? editModel;
    private bool loading = true;
    private bool notFound;
    private bool notAuthorized;
    private bool isPublish;
    private Guid postId;


    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        notFound = false;
        notAuthorized = false;

        var post = await Db.Posts.FirstOrDefaultAsync(p => p.Slug == Slug);

        if (post is null)
        {
            notFound = true;
            loading = false;
            return;
        }

        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!(user.Identity?.IsAuthenticated == true) || userId != post.AuthorId)
        {
            notAuthorized = true;
            loading = false;
            return;
        }

        postId = post.Id;

        // create edit model (shallow copy)
        editModel = new PostDto
        {
            Title = post.Title,
            Slug = post.Slug,
            Markdown = post.Markdown
        };

        isPublish = post.PublishedAtUtc.HasValue;
        loading = false;
    }

    private string testMessage = "Not clicked";

    private void TestInteractive()
    {
        testMessage = $"Interactive at {DateTime.Now:T}";
    }

    private void OnMarkdownInput(ChangeEventArgs e)
    {
        if (editModel is null)
        {
            return;
        }

        editModel.Markdown = e.Value?.ToString() ?? string.Empty;
    }

    private async Task SaveAsync()
    {
        if (editModel is null) return;

        var postToUpdate = await Db.Posts.FindAsync(postId);
        if (postToUpdate is null) return;

        postToUpdate.Title = editModel.Title;
        postToUpdate.Slug = editModel.Slug;
        postToUpdate.Markdown = editModel.Markdown;
        postToUpdate.UpdatedAtUtc = DateTimeOffset.UtcNow;

        await Db.SaveChangesAsync();

        // navigate to the post view after save
        Navigation.NavigateTo($"/posts/{postToUpdate.Slug}");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/posts/drafts");
    }
}
